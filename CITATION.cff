version: 0.3.0
date-released: 2026-11-05
license: MIT
repository-code: "https://github.com/hdbt/metrodag"
url: "https://hdbt.github.io/metrodag/"
keywords:
  - causal inference
  - directed acyclic graph
  - DAG
  - epidemiology
  - graph drawing
  - R package
